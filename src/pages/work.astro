---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionShell from "../components/sections/SectionShell.astro";
import AudioPlayer, { type Track } from "../components/media/AudioPlayer.astro";
import BilibiliPlayer, { type BilibiliVideo } from "../components/media/BilibiliPlayer.astro";

const tracks: Track[] = [
  {
    title: "Remember (remix)",
    artist: "烁音Ayane",
    artistUrl: "https://space.bilibili.com/19346228",
    url: "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/img/remember.mp3",
  },
  {
    title: "僕だけの青い空",
    artist: "烁音Ayane",
    artistUrl: "https://space.bilibili.com/19346228",
    url: "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/img/%E5%83%95%E3%81%A0%E3%81%91%E3%81%AE%E9%9D%92%E3%81%84%E7%A9%BA.mp3",
  },
  {
    title: "月下缭乱 (Orchestral)",
    artist: "DeemoAlice",
    artistUrl: "https://space.bilibili.com/389430530",
    url: "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/mp3/%E6%9C%88%E4%B8%8B%E7%BC%AD%E4%B9%B1-Orchestral.mp3",
  },
  {
    title: "Final Battle",
    artist: "热爱音乐的王小明同学",
    artistUrl: "https://space.bilibili.com/380065177",
    url: "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/mp3/Final%20Battle.mp3",
  },
  {
    title: "Winter",
    artist: "Alyxium欧石楠",
    artistUrl: "https://space.bilibili.com/1192681736",
    url: "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/mp3/winter.mp3",
  },
];

const videos: BilibiliVideo[] = [
  {
    title: "【大广赛陪跑作品】三福「定格万千生活」",
    aid: "115915714730498",
    bvid: "BV1sCksBEEgN",
    cid: "35464612446",
  },
  {
    title: "动画单品《从今往后，那片花海》",
    aid: "113899294693303",
    bvid: "BV13Ff2YiE7m",
    cid: "28107083462",
  },
];
---

<BaseLayout
  title="作品集 — FUS STUDIO"
  description="混音、母带与短片混音作品集，含音频试听与 Bilibili 视频。"
  name="FUS STUDIO"
>
  <PageHeader
    label="Works Collection / 作品集"
    lead="所有混音母带作品均由本人创作，仅供个人非商业用途的展示与说明。"
  >
    声音与画面，在此处陈列。
  </PageHeader>

  <SectionShell
    id="audio"
    index={1}
    label="Music / 音乐混音"
    title="音乐混音"
    description="点击曲目试听。原始音乐作品版权归属于各自的创作者、表演者及合法版权所有者。"
  >
    <AudioPlayer tracks={tracks} />
  </SectionShell>

  <SectionShell
    id="video"
    index={2}
    label="Film / 影视混音"
    title="影视混音"
    description="为广告与动画短片完成的混音与声音设计。"
  >
    <BilibiliPlayer videos={videos} />
  </SectionShell>

  <SectionShell
    id="contact"
    index={3}
    label="Start Project"
    title="开始一个项目"
    description="如果你有需要混音、母带或声音设计的作品，欢迎随时联系。"
    tone="graphite"
    isContact={true}
    email="1253607602@qq.com"
  />
</BaseLayout>
