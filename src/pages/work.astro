---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionShell from "../components/sections/SectionShell.astro";
import AudioPlayer from "../components/media/AudioPlayer.astro";
import BilibiliPlayer from "../components/media/BilibiliPlayer.astro";
import { tracks, videos } from "../data/media";
---

<BaseLayout
  title="作品集 — FUS STUDIO"
  description="混音、母带与短片混音作品集，含音频试听与 Bilibili 视频。"
  name="FUS STUDIO"
>
  <PageHeader
    label="Works Collection / 作品集"
    lead="所有混音母带作品均由本人创作，仅供个人非商业用途的展示与说明。"
  >
    声音与画面，在此处陈列。
  </PageHeader>

  <SectionShell
    id="audio"
    index={1}
    label="Music / 音乐混音"
    title="音乐混音"
    description="点击曲目试听。原始音乐作品版权归属于各自的创作者、表演者及合法版权所有者。"
  >
    <AudioPlayer tracks={tracks} />
  </SectionShell>

  <SectionShell
    id="video"
    index={2}
    label="Film / 影视混音"
    title="影视混音"
    description="为广告与动画短片完成的混音与声音设计。"
  >
    <BilibiliPlayer videos={videos} />
  </SectionShell>

  <SectionShell
    id="contact"
    index={3}
    label="Start Project"
    title="开始一个项目"
    description="如果你有需要混音、母带或声音设计的作品，欢迎随时联系。"
    tone="graphite"
    isContact={true}
    email="1253607602@qq.com"
    socialLinks={[
      { label: "GitHub", href: "https://github.com/FUS-37" },
      { label: "Bilibili", href: "https://space.bilibili.com/22665738" },
    ]}
  />
</BaseLayout>
