---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionShell from "../components/sections/SectionShell.astro";
import ArchiveGrid from "../components/archive/ArchiveGrid.astro";
import PostRecord from "../components/archive/PostRecord.astro";
import ContactSection from "../components/sections/ContactSection.astro";

const postModules = import.meta.glob("./posts/**/*.md", {
  eager: true,
});

const posts = Object.values(postModules)
  .map((module: any) => ({
    ...module.frontmatter,
    url: module.url,
  }))
  .filter((post) => !post.draft)
  .sort(
    (a, b) =>
      new Date(b.publishedAt).getTime() -
      new Date(a.publishedAt).getTime(),
  );
---

<BaseLayout
  title="思想档案 — FUS STUDIO"
  description="关于混音、母带、音乐制作、DSP 与插件开发的文章。"
  name="FUS STUDIO"
>
  <PageHeader
    label="Reading Room / 思想档案"
    lead="关于声音、工具和工作方法的持续记录。"
  >
    建筑深处的阅览室。
  </PageHeader>

  <SectionShell
    index={1}
    label={`${String(posts.length).padStart(2, "0")} Records`}
    title="全部文章"
    description="方法、观察与尚未完成的判断。"
  >
    {
      posts.length > 0 ? (
        <ArchiveGrid columns={2}>
          {posts.map((post, index) => (
            <PostRecord
              title={post.title}
              date={post.publishedAt}
              description={post.description}
              category={post.category}
              readingTime={post.readingTime}
              href={post.url}
              index={index}
            />
          ))}
        </ArchiveGrid>
      ) : (
        <p class="empty">目前没有公开档案。</p>
      )
    }
  </SectionShell>

  <ContactSection
    title="阅读结束，空间重新通向建筑。"
    description="如果某项记录与你正在处理的问题有关，可以直接联系。"
    email="hello@example.com"
  />
</BaseLayout>

<style>
  .empty {
    padding: 4rem;
    border: 1px solid var(--line-soft);
    color: var(--text-secondary);
    text-align: center;
  }
</style>
