---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionShell from "../components/sections/SectionShell.astro";
---

<BaseLayout
  title="关于我与专业咨询 — FUS STUDIO"
  description="音乐制作人、混音/母带工程师、VST3 插件开发者与专业音频咨询。"
  name="FUS STUDIO"
>
  <PageHeader
    label="About & Consultation / 关于我与咨询"
    lead="从音乐创作、混音母带到 VST3 DSP 开发，我专注于让声音决策变得更直接、有效。"
  >
    关于我，以及这间工作室。
  </PageHeader>

  <SectionShell
    index={1}
    label="Profile / 个人简介"
    title="制作、工程与软件开发的结合"
  >
    <div class="profile-grid">
      <div class="resume">
        <h3 class="resume__title">个人履历</h3>
        <div class="resume__group">
          <h4 class="resume__group-title">混音 · 母带</h4>
          <ul class="resume__list">
            <li>合作音乐人：克艾尔西、烁音Ayane、热爱音乐的王小明同学</li>
            <li>影视混音与声音设计：三福「定格万千生活」</li>
          </ul>
        </div>
        <div class="resume__group">
          <h4 class="resume__group-title">技术栈</h4>
          <ul class="resume__list">
            <li>C++ / JUCE、DSP 算法设计、音频工程</li>
          </ul>
        </div>
        <div class="resume__group">
          <h4 class="resume__group-title">当前状态</h4>
          <ul class="resume__list">
            <li>独立线上工作室，世界探索中</li>
          </ul>
        </div>
      </div>

      <div class="about-text">
        <p>
          我是 FUS，一名独立音乐制作人、混音与母带工程师，同时从事 VST3 音频软件开发；目前为 NTU EEE 在读研究生。
        </p>
        <p>
          我不断探索 DSP 算法的边界，并将多年积累的音乐观察融入插件开发——不止追求更优的 DSP 算法，更相信值得信赖的人类审美判断。
        </p>
        <p>
          这是一间个人工作室，独立运行于互联网之海，链接人与人之间的孤岛。
        </p>
      </div>
    </div>
  </SectionShell>

  <SectionShell
    index={2}
    label="Business & Cooperation / 业务与合作"
    title="业务范围与合作方式"
  >
    <div class="biz-grid">
      <div class="biz-col">
        <h3 class="biz-col__title">业务范围</h3>
        <ul class="biz-list">
          <li>
            <span class="biz-list__num">01</span>
            <div>
              <h4>混音与母带</h4>
              <p>多轨混音、专辑母带，以及流媒体/数字标准的最终交付。</p>
            </div>
          </li>
          <li>
            <span class="biz-list__num">02</span>
            <div>
              <h4>VST3 / DSP 开发</h4>
              <p>JUCE 框架开发、DSP 算法设计与自定义音频处理器。</p>
            </div>
          </li>
          <li>
            <span class="biz-list__num">03</span>
            <div>
              <h4>专业音频咨询</h4>
              <p>混音案例诊断、留学规划与开发技术指导。</p>
            </div>
          </li>
          <li>
            <span class="biz-list__num">04</span>
            <div>
              <h4>声音设计</h4>
              <p>影视/游戏音效与声音品牌氛围设计。</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="biz-col">
        <h3 class="biz-col__title">合作方式</h3>
        <ol class="biz-steps">
          <li>
            <span class="biz-steps__num">01</span>
            <div>
              <h4>发送需求</h4>
              <p>通过邮箱发送项目 Demo、参考或需求描述。</p>
            </div>
          </li>
          <li>
            <span class="biz-steps__num">02</span>
            <div>
              <h4>评估报价</h4>
              <p>确认项目范围、周期与预算。</p>
            </div>
          </li>
          <li>
            <span class="biz-steps__num">03</span>
            <div>
              <h4>确认启动</h4>
              <p>达成一致后进入制作或开发阶段。</p>
            </div>
          </li>
          <li>
            <span class="biz-steps__num">04</span>
            <div>
              <h4>迭代交付</h4>
              <p>反馈迭代，直至满意交付。</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </SectionShell>

  <SectionShell
    id="contact"
    index={3}
    label="Consultation Booking"
    title="预约咨询或开始合作"
    description="通过邮箱发送你的项目 Demo 或咨询需求。"
    tone="graphite"
    isContact={true}
    email="fusmixing@163.com"
    socialLinks={[
      { label: "GitHub", href: "https://github.com/FUS-37" },
      { label: "Bilibili", href: "https://space.bilibili.com/22665738" },
    ]}
  />
</BaseLayout>

<style>
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .about-text {
    display: grid;
    gap: 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: 1.8;
  }

  .resume {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .resume__title {
    width: fit-content;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--brass);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .resume__group {
    display: grid;
    gap: 0.75rem;
  }

  .resume__group-title {
    color: var(--brass-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .resume__list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  .resume__list li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .resume__list li::before {
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--brass);
    content: "";
  }

  .biz-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .biz-col {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .biz-col__title {
    width: fit-content;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--brass);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .biz-list {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .biz-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line-medium);
    background: linear-gradient(135deg, var(--paper-bright), rgb(0 0 0 / 5%));
  }

  .biz-steps {
    display: grid;
    list-style: none;
  }

  .biz-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .biz-steps li:last-child {
    border-bottom: 0;
  }

  .biz-list__num,
  .biz-steps__num {
    color: var(--brass-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .biz-list h4,
  .biz-steps h4 {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .biz-list p,
  .biz-steps p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 48rem) {
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .biz-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
