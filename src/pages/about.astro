---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionShell from "../components/sections/SectionShell.astro";
---

<BaseLayout
  title="关于我与专业咨询 — FUS STUDIO"
  description="音乐制作人、混音/母带工程师、VST3 插件开发者与专业音频咨询。"
  name="FUS STUDIO"
>
  <PageHeader
    label="About & Consultation / 关于我与咨询"
    lead="从音乐创作、混音母带到 VST3 DSP 开发，我专注于让声音决策变得更直接、有效。"
  >
    关于我，以及这间工作室。
  </PageHeader>

  <SectionShell
    index={1}
    label="Profile / 个人简介"
    title="制作、工程与软件开发的结合"
  >
    <div class="about-grid">
      <div class="about-text">
        <p>
          我是 FUS，一名独立音乐制作人、混音与母带工程师，同时从事 VST3 音频软件开发；目前为 NTU EEE 在读研究生。
        </p>
        <p>
          我不断探索 DSP 算法的边界，并将多年积累的音乐观察融入插件开发——不止追求更优的 DSP 算法，更相信值得信赖的人类审美判断。
        </p>
        <p>
          这是一间个人工作室，独立运行于互联网之海，链接人与人之间的孤岛。
        </p>
      </div>

      <div class="services-list">
        <div class="service-item">
          <span class="service-item__index">01</span>
          <h3>混音与母带</h3>
          <p>单曲、EP 或专辑的多轨混音与最终数字/流媒体标准母带交付。</p>
        </div>

        <div class="service-item">
          <span class="service-item__index">02</span>
          <h3>VST3 插件开发</h3>
          <p>JUCE 框架开发、DSP 算法设计、自定义音频处理器与工作流工具。</p>
        </div>

        <div class="service-item">
          <span class="service-item__index">03</span>
          <h3>专业咨询</h3>
          <p>混音案例诊断、留学规划、JUCE/DSP 算法开发指导。</p>
        </div>
      </div>
    </div>
  </SectionShell>

  <SectionShell
    id="contact"
    index={2}
    label="Consultation Booking"
    title="预约咨询或开始合作"
    description="通过邮箱发送你的项目 Demo 或咨询需求。"
    tone="graphite"
    isContact={true}
    email="1253607602@qq.com"
    socialLinks={[
      { label: "GitHub", href: "https://github.com/FUS-37" },
      { label: "Bilibili", href: "https://space.bilibili.com/22665738" },
    ]}
  />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .about-text {
    display: grid;
    gap: 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: 1.8;
  }

  .services-list {
    display: grid;
    gap: 1rem;
  }

  .service-item {
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--line-medium);
    background:
      repeating-radial-gradient(
        circle,
        rgb(27 28 27 / 4%) 0 0.4px,
        transparent 0.6px 5px
      ),
      linear-gradient(135deg, var(--paper-bright), rgb(0 0 0 / 5%));
    box-shadow: 0 0.5rem 1.4rem rgb(20 20 19 / 7%);
    overflow: hidden;
  }

  .service-item__index {
    position: absolute;
    top: 0.5rem;
    right: 0.8rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--brass-dark);
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .service-item h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .service-item p {
    color: var(--text-secondary);
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
