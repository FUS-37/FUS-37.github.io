---
import PlateCard from "./PlateCard.astro";
import ActionLink from "../ui/ActionLink.astro";

interface Props {
  title: string;
  artist: string;
  year: string | number;
  duration?: string;
  role?: string;
  description?: string;
  href?: string;
  audio?: string;
  index?: number;
}

const {
  title,
  artist,
  year,
  duration,
  role = "Mix / Master",
  description,
  href,
  audio,
  index = 0,
} = Astro.props;

const levels = [
  22, 38, 68, 47, 78, 92, 58, 34, 64, 83, 44, 71,
  95, 62, 31, 52, 76, 88, 49, 27, 61, 81, 56, 36,
];

const shiftedLevels = levels.map(
  (_, levelIndex) => levels[(levelIndex + index * 5) % levels.length],
);

const meta = [year, duration, role].filter(Boolean).join(" · ");
---

<PlateCard
  index={index}
  title={title}
  meta={meta}
  description={`${artist}${description ? ` — ${description}` : ""}`}
  tone="paper"
>
  <div class="work-record">
    <div class="work-record__signal" aria-hidden="true">
      <span class="work-record__baseline"></span>
      {
        shiftedLevels.map((level) => (
          <i style={`--level:${level}%`}></i>
        ))
      }
    </div>

    <dl>
      <div>
        <dt>Artist</dt>
        <dd>{artist}</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{year}</dd>
      </div>
    </dl>

    {
      audio && (
        <audio controls preload="none">
          <source src={audio} />
        </audio>
      )
    }

    {
      href && (
        <ActionLink href={href} variant="outline">查看完整档案</ActionLink>
      )
    }
  </div>
</PlateCard>

<style>
  .work-record {
    display: grid;
    gap: 1.6rem;
  }

  .work-record__signal {
    position: relative;
    display: flex;
    height: 5.5rem;
    align-items: center;
    gap: clamp(0.15rem, 0.5vw, 0.4rem);
    overflow: hidden;
    padding-inline: 0.4rem;
  }

  .work-record__signal i {
    width: 100%;
    height: var(--level);
    min-height: 0.2rem;
    background: linear-gradient(to top, var(--brass-dark), var(--brass-light));
    opacity: 0.75;
  }

  .work-record__baseline {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line-medium);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
  }

  dl div {
    padding: 0.9rem 0.4rem;
    border-bottom: 1px solid var(--line-soft);
  }

  dt {
    margin-bottom: 0.3rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dd {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  audio {
    width: 100%;
    height: 2.5rem;
    opacity: 0.7;
  }

  @media (max-width: 32rem) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
