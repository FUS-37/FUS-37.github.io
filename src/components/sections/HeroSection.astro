---
interface Link {
  href: string;
  label: string;
}

interface Props {
  name: string;
  subtitle?: string;
  links?: Link[];
}

const {
  name,
  subtitle = "Producer · Mixing Engineer · Audio Developer",
  links = [
    { href: "#work", label: "作品" },
    { href: "#plugins", label: "插件" },
    { href: "#posts", label: "文章" },
    { href: "#contact", label: "联系" },
  ],
} = Astro.props;

const parts = name.trim().split(/\s+/);
---

<section class="hero" aria-labelledby="hero-title">
  <!-- 构成主义几何层：斜置黑色钢板 + 条码 -->
  <div class="hero__geometry" aria-hidden="true">
    <span class="hero__plate"></span>
    <span class="hero__barcode"></span>
  </div>

  <div class="hero__content container">
    <p class="hero__kicker">{subtitle}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__title-dots" aria-hidden="true"></span>
      {
        parts.map((part, index) => (
          <span
            class:list={[
              "hero__line",
              index === 1 && "hero__line--indent",
            ]}
          >
            {part}
          </span>
        ))
      }
    </h1>

    <nav class="hero__nav" aria-label="首页导航">
      {
        links.map((link, index) => (
          <a href={link.href}>
            <span class="hero__nav-index">{String(index + 1).padStart(2, "0")}</span>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- 四角定位十字标记 -->
  <div class="hero__marks" aria-hidden="true">
    <i></i><i></i><i></i><i></i>
  </div>

  <a class="hero__scroll" href="#work">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-label mono">向下 / SCROLL</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    min-height: 100svh;
    align-items: center;
    overflow: hidden;
    padding: 7rem var(--gutter) 6rem;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    max-width: 72rem;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* 几何层 */
  .hero__geometry {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__plate {
    position: absolute;
    top: -6%;
    right: -12%;
    width: clamp(16rem, 40vw, 38rem);
    height: 118%;
    background:
      repeating-linear-gradient(
        122deg,
        rgb(255 255 255 / 4%) 0 1px,
        transparent 1px 4px
      ),
      linear-gradient(122deg, var(--graphite), var(--ink));
    clip-path: polygon(46% 0, 100% 0, 100% 100%, 0 100%);
    box-shadow: -1.5rem 0 3rem rgb(20 20 19 / 20%);
  }

  .hero__barcode {
    position: absolute;
    bottom: 4%;
    left: var(--gutter);
    width: 9rem;
    height: 3.5rem;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 5px,
      var(--ink) 5px 8px,
      transparent 8px 10px,
      var(--ink) 10px 11px,
      transparent 11px 15px
    );
    opacity: 0.55;
  }

  .hero__kicker {
    color: var(--brass);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    animation: hero-enter 0.8s var(--ease-out) 0.05s both;
  }

  .hero__title {
    position: relative;
    isolation: isolate;
    display: grid;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  /* 标题背后的圆形点阵 */
  .hero__title-dots {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: clamp(18rem, 40vw, 36rem);
    height: clamp(18rem, 40vw, 36rem);
    border-radius: 50%;
    background-image: radial-gradient(
      circle,
      rgb(23 24 23 / 20%) 1.4px,
      transparent 1.6px
    );
    background-size: 13px 13px;
    transform: translate(-50%, -50%);
    -webkit-mask-image: radial-gradient(circle, #000 0 30%, transparent 66%);
    mask-image: radial-gradient(circle, #000 0 30%, transparent 66%);
  }

  .hero__line {
    display: block;
    opacity: 0;
    animation: hero-enter 1s var(--ease-out) 0.16s both;
  }

  .hero__line--indent {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    margin-left: clamp(1rem, 6vw, 6rem);
  }

  .hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.4rem, 4vw, 3.5rem);
    opacity: 0;
    animation: hero-enter 0.8s var(--ease-out) 0.38s both;
  }

  .hero__nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .hero__nav-index {
    color: var(--brass-dark);
    font-size: 0.58rem;
  }

  .hero__nav a:hover {
    color: var(--ink);
    transform: translateY(-0.12rem);
  }

  .hero__marks i {
    position: absolute;
    width: 0.85rem;
    height: 0.85rem;
  }

  .hero__marks i::before,
  .hero__marks i::after {
    position: absolute;
    background: var(--ink);
    content: "";
    opacity: 0.6;
  }

  .hero__marks i::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }

  .hero__marks i::after {
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .hero__marks i:nth-child(1) { top: 6.5rem; left: var(--gutter); }
  .hero__marks i:nth-child(2) { top: 6.5rem; right: var(--gutter); }
  .hero__marks i:nth-child(3) { bottom: 2.5rem; left: var(--gutter); }
  .hero__marks i:nth-child(4) { bottom: 2.5rem; right: var(--gutter); }

  .hero__scroll {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    opacity: 0;
    animation: hero-fade 0.8s var(--ease-out) 0.6s both;
  }

  .hero__scroll-line {
    width: 1px;
    height: 2.6rem;
    background: linear-gradient(to bottom, transparent, var(--ink), transparent);
    animation: scroll-breathe 2.8s ease-in-out infinite;
    transform-origin: top;
  }

  .hero__scroll-label {
    color: var(--text-secondary);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    writing-mode: vertical-rl;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
      filter: blur(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes scroll-breathe {
    0%,
    100% {
      opacity: 0.25;
      transform: scaleY(0.55);
    }

    50% {
      opacity: 0.85;
      transform: scaleY(1);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      padding-top: 6rem;
    }

    .hero__plate {
      width: 20rem;
      opacity: 0.85;
    }

    .hero__scroll {
      display: none;
    }
  }
</style>
