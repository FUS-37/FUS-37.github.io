---
interface Props {
  label: string;
  lead?: string;
  image?: string;
}

const {
  label,
  lead,
  image = "https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/img/reoenl%20(1).jpg",
} = Astro.props;
---

<header class="page-header" style={`--page-header-bg: url("${image}");`}>
  <div class="container">
    <span class="page-header__label">{label}</span>
    <h1><slot /></h1>
    {lead && <p class="page-header__lead">{lead}</p>}
  </div>
  <span class="page-header__corner" aria-hidden="true"></span>
</header>

<style>
  .page-header {
    position: relative;
    z-index: var(--z-content);
    overflow: hidden;
    padding-block: clamp(8rem, 15vw, 13rem) clamp(3rem, 6vw, 5rem);
  }

  .page-header::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.5)),
      var(--page-header-bg);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    content: "";
    pointer-events: none;
  }

  .page-header .container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.4rem;
  }

  .page-header__label {
    width: fit-content;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--brass);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 0.96;
  }

  .page-header__lead {
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: var(--text-lead);
  }

  .page-header__corner {
    position: absolute;
    top: 0;
    right: -6%;
    width: clamp(9rem, 26vw, 22rem);
    height: 100%;
    background:
      repeating-linear-gradient(
        122deg,
        rgb(255 255 255 / 4%) 0 1px,
        transparent 1px 4px
      ),
      linear-gradient(122deg, var(--concrete-cool), var(--concrete-shadow));
    clip-path: polygon(60% 0, 100% 0, 100% 100%, 0 100%);
    opacity: 0.55;
  }
</style>
