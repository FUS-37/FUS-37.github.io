---
interface Props {
  concrete?: boolean;
  steel?: boolean;
  light?: boolean;
}

const {
  concrete = true,
  steel = true,
  light = true,
} = Astro.props;
---

<div class="atmosphere" data-atmosphere aria-hidden="true">
  {concrete && <div class="atmosphere__concrete"></div>}
  {steel && <div class="atmosphere__steel"></div>}

  <div class="atmosphere__dots">
    <i class="atmosphere__dot atmosphere__dot--grid"></i>
    <i class="atmosphere__dot atmosphere__dot--band"></i>
  </div>

  {light && <div class="atmosphere__light"></div>}
  <div class="atmosphere__vignette"></div>
</div>

<style>
  .atmosphere {
    position: fixed;
    z-index: var(--z-environment);
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* 超写实混凝土底：冷暖两个光源叠加 */
  .atmosphere__concrete {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 72% 8%, var(--paper-bright), transparent 55%),
      radial-gradient(80% 60% at 12% 100%, rgb(0 0 0 / 4%), transparent 60%),
      linear-gradient(180deg, var(--paper) 0%, var(--concrete) 100%);
  }

  /* 斜置拉丝钢板：构成主义的硬切面 */
  .atmosphere__steel {
    position: absolute;
    top: -18%;
    right: -22%;
    width: 62%;
    height: 140%;
    background:
      repeating-linear-gradient(
        115deg,
        rgb(255 255 255 / 4%) 0 1px,
        transparent 1px 3px
      ),
      linear-gradient(115deg, var(--concrete-cool), var(--concrete-shadow));
    clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%);
    opacity: 0.5;
  }

  /* 点阵图形：穿插于背景中的构成主义网点 */
  .atmosphere__dots {
    position: absolute;
    inset: 0;
  }

  .atmosphere__dot {
    position: absolute;
    display: block;
  }

  /* 左下：黄铜细密点阵网格 */
  .atmosphere__dot--grid {
    bottom: 5%;
    left: 2%;
    width: clamp(12rem, 22vw, 22rem);
    height: clamp(12rem, 22vw, 22rem);
    background-image: radial-gradient(
      circle,
      rgb(63 143 123 / 20%) 1px,
      transparent 1.3px
    );
    background-size: 8px 8px;
    -webkit-mask-image: radial-gradient(
      92% 92% at 12% 88%,
      #000 18%,
      transparent 68%
    );
    mask-image: radial-gradient(
      92% 92% at 12% 88%,
      #000 18%,
      transparent 68%
    );
  }

  /* 中部：斜切点阵带 */
  .atmosphere__dot--band {
    top: 42%;
    left: -4%;
    width: 34%;
    height: 22%;
    background-image: radial-gradient(
      circle,
      rgb(23 24 23 / 15%) 1px,
      transparent 1.4px
    );
    background-size: 9px 9px;
    transform: rotate(18deg);
    clip-path: polygon(12% 0, 100% 8%, 88% 100%, 0 92%);
    -webkit-mask-image: linear-gradient(120deg, #000 18%, transparent 78%);
    mask-image: linear-gradient(120deg, #000 18%, transparent 78%);
  }

  /* 顶部软光 + 边缘暗角 */
  .atmosphere__light {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 42% at 50% -10%,
      rgb(255 255 255 / 55%),
      transparent 60%
    );
    mix-blend-mode: soft-light;
  }

  .atmosphere__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 120% at 50% 40%,
      transparent 55%,
      rgb(20 20 19 / 10%) 100%
    );
  }
</style>
