---
interface Link {
  href: string;
  label: string;
}

interface MoreGroup {
  label: string;
  links: Link[];
}

interface Props {
  name: string;
  links?: Link[];
  more?: MoreGroup;
}

const {
  name,
  links = [
    { href: "/#work", label: "作品" },
    { href: "/#plugins", label: "插件" },
    { href: "/#posts", label: "文章" },
    { href: "/#contact", label: "联系" },
  ],
  more = {
    label: "更多",
    links: [
      { href: "/album", label: "相册" },
      { href: "/moments", label: "动态" },
    ],
  },
} = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a class="header__identity" href="/">
      <img
        class="header__mark"
        src="https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/img/fslogo.png"
        alt=""
        width="26"
        height="26"
      />
      <span>{name}</span>
    </a>

    <nav aria-label="主导航">
      {
        links.map((link, index) => (
          <a href={link.href}>
            <span class="nav__index">{String(index + 1).padStart(2, "0")}</span>
            <span>{link.label}</span>
          </a>
        ))
      }

      {
        more && (
          <div class="nav__more">
            <button type="button" class="nav__more-trigger">
              <span class="nav__index">{String(links.length + 1).padStart(2, "0")}</span>
              <span>{more.label}</span>
              <span class="nav__more-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav__more-panel">
              {more.links.map((link) => (
                <a href={link.href}>
                  <span class="nav__index nav__index--ghost" aria-hidden="true">
                    {String(links.length + 1).padStart(2, "0")}
                  </span>
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </nav>
  </div>
</header>

<script>
  let lastY = window.scrollY;
  let ticking = false;

  const update = () => {
    const header = document.querySelector<HTMLElement>(".header");
    const y = window.scrollY;

    header?.classList.toggle("is-scrolled", y > 24);
    header?.classList.toggle("is-hidden", y > 280 && y > lastY);

    lastY = y;
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );

  document.addEventListener("astro:page-load", update);
</script>

<style>
  .header {
    position: fixed;
    z-index: var(--z-navigation);
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid transparent;
    transition:
      transform 0.5s var(--ease-out),
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .header.is-scrolled {
    border-bottom-color: var(--line-medium);
    background: rgb(255 255 255 / 86%);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    width: 100%;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
    padding-inline: var(--gutter);
  }

  .header__identity {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.2rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .header__mark {
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    object-fit: contain;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3.2rem);
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: 0.06em;
    transition: color var(--duration-fast) ease;
  }

  .nav__index {
    color: var(--ink);
    font-size: 0.68rem;
  }

  .nav__index--ghost {
    visibility: hidden;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 2px;
    background: var(--ink);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* —— 更多：hover 展开子链接（无框） —— */
  .nav__more {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav__more::before {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 1rem;
    content: "";
  }

  .nav__more-trigger {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: default;
    transition: color var(--duration-fast) ease;
  }

  .nav__more-trigger:hover {
    color: var(--ink);
  }

  .nav__more-caret {
    color: var(--ink);
    font-size: 0.68rem;
    transition: transform var(--duration-fast) ease;
  }

  .nav__more:hover .nav__more-caret,
  .nav__more:focus-within .nav__more-caret {
    transform: rotate(180deg);
  }

  /* 无框面板：子链接纯文字浮出，无边框/背景/阴影 */
  .nav__more-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25rem);
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease,
      visibility var(--duration-fast) ease;
  }

  .nav__more:hover .nav__more-panel,
  .nav__more:focus-within .nav__more-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 40rem) {
    .header__inner {
      min-height: 4.5rem;
      align-items: flex-start;
      padding-top: 1.1rem;
    }

    .header__mark {
      width: 1.35rem;
      height: 1.35rem;
    }

    nav {
      max-width: 15rem;
      justify-content: flex-end;
      gap: 0.45rem 1.1rem;
    }
  }
</style>
