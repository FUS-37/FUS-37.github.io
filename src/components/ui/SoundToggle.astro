---
interface Props {
  src?: string;
}

const { src } = Astro.props;
---

{
  src && (
    <div class="sound" data-sound>
      <audio loop preload="none" data-sound-audio>
        <source src={src} />
      </audio>

      <button
        type="button"
        class="sound__button"
        data-sound-button
        aria-label="开启环境音"
        aria-pressed="false"
      >
        <span class="sound__bars" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span data-sound-label>Sound off</span>
      </button>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>("[data-sound]").forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>("[data-sound-audio]");
    const button = root.querySelector<HTMLButtonElement>("[data-sound-button]");
    const label = root.querySelector<HTMLElement>("[data-sound-label]");

    if (!audio || !button || !label) return;

    audio.volume = 0.17;

    const update = () => {
      const playing = !audio.paused;

      button.setAttribute("aria-pressed", String(playing));
      button.setAttribute(
        "aria-label",
        playing ? "关闭环境音" : "开启环境音",
      );

      label.textContent = playing ? "Sound on" : "Sound off";
    };

    button.addEventListener("click", async () => {
      if (audio.paused) {
        await audio.play();
      } else {
        audio.pause();
      }

      update();
    });

    update();
  });
</script>

<style>
  .sound {
    position: fixed;
    z-index: var(--z-navigation);
    right: 1rem;
    bottom: 1rem;
  }

  .sound__button {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line-soft);
    background: rgb(255 255 255 / 78%);
    color: var(--text-secondary);
    cursor: pointer;
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sound__bars {
    display: flex;
    height: 0.8rem;
    align-items: end;
    gap: 2px;
  }

  .sound__bars i {
    width: 1px;
    height: 30%;
    background: currentColor;
  }

  .sound__bars i:nth-child(2) {
    height: 85%;
  }

  .sound__bars i:nth-child(3) {
    height: 55%;
  }

  .sound__button[aria-pressed="true"] {
    color: var(--brass-dark);
  }

  .sound__button[aria-pressed="true"] .sound__bars i {
    animation: sound-level 0.9s ease-in-out infinite alternate;
  }

  .sound__button[aria-pressed="true"] .sound__bars i:nth-child(2) {
    animation-delay: -0.3s;
  }

  .sound__button[aria-pressed="true"] .sound__bars i:nth-child(3) {
    animation-delay: -0.6s;
  }

  @keyframes sound-level {
    from {
      height: 25%;
    }

    to {
      height: 100%;
    }
  }
</style>
