---
import "../styles/tokens.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Atmosphere from "../components/atmosphere/Atmosphere.astro";
import MinimalHeader from "../components/navigation/MinimalHeader.astro";
import SoundToggle from "../components/ui/SoundToggle.astro";
import FloatingPlayer from "../components/ui/FloatingPlayer.astro";

interface Props {
  title?: string;
  description?: string;
  name?: string;
  environment?: boolean;
  ambientAudio?: string;
  header?: boolean;
}

const {
  title = "FUS STUDIO",
  description = "音乐制作、混音、母带与音频软件。",
  name = "FUS STUDIO",
  environment = true,
  ambientAudio,
  header = true,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    <ClientRouter />

    <link rel="canonical" href={canonical} />

    <link
      rel="icon"
      type="image/png"
      href="https://w3svwsauq3bn5lj.oss-cn-beijing.aliyuncs.com/img/fslogo.png"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <title>{title}</title>
  </head>

  <body>
    {environment && <Atmosphere />}
    {header && <MinimalHeader name={name} />}

    <main>
      <slot />
    </main>

    <SoundToggle src={ambientAudio} />
    <FloatingPlayer />
  </body>
</html>

<script>
  /* —— 滚动进场 + 滚动视差（初始加载与 View Transitions 切换后均需重新初始化） —— */
  document.addEventListener("astro:page-load", () => {
    initReveal();
    initParallax();
  });

  /* 滚动进场：为 [data-reveal] 添加可见态 */
  function initReveal() {
    const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");

    if (revealEls.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );

    revealEls.forEach((el) => observer.observe(el));
  }

  /* —— 滚动视差引擎（单例）：lerp 惯性平滑 + translate 走合成器 —— */
  const PARALLAX_LERP = 0.1; // 惯性系数，越大越跟手（借鉴 cassette 的阻尼）

  interface ParallaxEngine {
    refresh: (els: HTMLElement[]) => void;
    dispose: () => void;
  }

  let parallaxEngine: ParallaxEngine | null = null;

  function initParallax() {
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const els = Array.from(
      document.querySelectorAll<HTMLElement>("[data-parallax]"),
    );

    if (reduced || els.length === 0) {
      parallaxEngine?.dispose();
      parallaxEngine = null;
      return;
    }

    if (parallaxEngine) {
      parallaxEngine.refresh(els);
      return;
    }

    parallaxEngine = createParallaxEngine(els);
  }

  function createParallaxEngine(els: HTMLElement[]): ParallaxEngine {
    const items = els.map((el) => ({
      el,
      speed: Number.parseFloat(el.dataset.parallaxSpeed ?? "0"),
    }));

    let target = window.scrollY;
    let smooth = target;
    let rafId = 0;
    let running = false;

    const onScroll = () => {
      target = window.scrollY;
      if (!running) {
        running = true;
        rafId = requestAnimationFrame(tick);
      }
    };

    const tick = () => {
      smooth += (target - smooth) * PARALLAX_LERP;

      for (const it of items) {
        it.el.style.setProperty(
          "translate",
          `0 ${(-smooth * it.speed).toFixed(2)}px`,
        );
      }

      if (Math.abs(target - smooth) > 0.1) {
        rafId = requestAnimationFrame(tick);
      } else {
        smooth = target;
        running = false;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();

    return {
      refresh(els: HTMLElement[]) {
        items.length = 0;
        for (const el of els) {
          items.push({
            el,
            speed: Number.parseFloat(el.dataset.parallaxSpeed ?? "0"),
          });
        }
        onScroll();
      },
      dispose() {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        if (rafId) cancelAnimationFrame(rafId);
        running = false;
        for (const it of items) it.el.style.setProperty("translate", "");
      },
    };
  }
</script>
